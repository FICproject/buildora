# ========================================================
# BUILDORA 60 - Multi-Tenant Quick-Commerce SaaS Platform
# Environment Variables Blueprint (Structure Only)
# ========================================================

# General Monorepo
NODE_ENV=development
APP_PORT_GATEWAY=8000
APP_PORT_API=3000
APP_PORT_WORKER=3001

# Web Applications Ports
PORT_CUSTOMER_WEB=5173
PORT_VENDOR_WEB=5174
PORT_DELIVERY_WEB=5175
PORT_COMPANY_ADMIN_WEB=5176
PORT_PLATFORM_ADMIN_WEB=5177

# Multi-Tenancy & Platform
PLATFORM_DEFAULT_TENANT_ID=buildora-platform
PLATFORM_DOMAIN=buildora.com

# Database (MongoDB Structure)
MONGODB_URI=mongodb://localhost:27017/buildora
MONGODB_DATABASE=buildora_master

# Cache & Message Broker (Redis Structure)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Infrastructure (Placeholders)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_ASSETS=

# Backend CORS & Security
CORS_ALLOWED_ORIGINS=https://buildora-jtns.vercel.app,https://buildora-vendor.vercel.app
JWT_SECRET=

# Email OTP Provider (SendGrid or Resend)
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# SMS OTP Provider (Twilio or MSG91)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Set to "true" only for non-production staging when external Email/SMS gateways are not yet attached
ALLOW_DEV_OTP_FALLBACK=false
